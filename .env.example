# SMTP settings for Summary Email feature
EMAIL_PROVIDER=smtp
EMAIL_WEBHOOK_URL=

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=you@company.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@company.com
SMTP_USE_TLS=true

# Graph settings (required when EMAIL_PROVIDER=graph)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-app-client-id
GRAPH_CLIENT_SECRET=your-app-client-secret
GRAPH_SENDER_EMAIL=you@company.com
GRAPH_SENDER_USER_ID=your-sender-user-object-id
